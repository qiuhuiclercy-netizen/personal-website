# ============================================================
# VideoTranslator 配置文件 - 复制为 .env 并填入真实密钥
# ============================================================

# DeepSeek API（翻译用）
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 火山方舟 TTS（角色声音）
# 控制台：https://console.volcengine.com/speech/app
VOLC_APP_ID=your_volc_app_id
VOLC_ACCESS_TOKEN=your_volc_access_token
VOLC_CLUSTER=volcano_tts

# 讯飞 TTS（备选）
XUNFEI_APPID=your_xunfei_appid
XUNFEI_API_KEY=your_xunfei_api_key
XUNFEI_API_SECRET=your_xunfei_api_secret

# Whisper 配置（本地运行，无需 API Key）
# 可选：tiny / base / small / medium / large（越大越准但越慢）
WHISPER_MODEL=base

# 服务配置
HOST=0.0.0.0
PORT=8000
MAX_VIDEO_SIZE_MB=500
TEMP_DIR=./temp
OUTPUT_DIR=./output
